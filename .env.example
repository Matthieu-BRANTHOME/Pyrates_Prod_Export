# Copy this file to .env and fill in the values. .env is git-ignored.

MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Name of the view holding the joined traces. Case-sensitive on the server.
MYSQL_TRACES_VIEW=

# Set to true to encrypt the connection (recommended if the server supports it).
MYSQL_SSL=false

# Default export range, both dates inclusive (can be overridden with --start / --end).
EXPORT_START=2024-11-18
EXPORT_END=2026-11-18

# Optional tuning.
# EXPORT_DIR=data/traces
# CHUNK_SIZE=50000
# MYSQL_READ_TIMEOUT=3600
